{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VM Launcher",
  "identifier": "net.local.vm-launch",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Windows VM", "width": 920, "height": 720, "minWidth": 860, "minHeight": 700, "resizable": true, "center": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
